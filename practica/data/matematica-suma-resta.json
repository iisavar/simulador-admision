  "repaso": {
    "idea": "Con signos iguales se suman los valores y se conserva el signo. Con signos distintos se restan los valores y se pone el signo del número de mayor valor absoluto. Restar un número es sumar su opuesto.",
    "ejemplo": {
      "enunciado": "Calcula: −8 − (−5) + 3",
      "pasos": [
        "Restar −5 es sumar su opuesto: −8 − (−5) = −8 + 5.",
        "−8 + 5: signos distintos, 8 − 5 = 3 y gana el signo del 8 → −3.",
        "−3 + 3 = 0, porque son opuestos."
      ],
      "resultado": "0"
    },
    "ojo": "Olvidar que «menos por menos» en − (−5) se convierte en + 5."
  },
