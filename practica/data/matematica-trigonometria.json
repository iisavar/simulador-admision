  "repaso": {
    "idea": "En un triángulo rectángulo: sen = cateto opuesto/hipotenusa, cos = cateto adyacente/hipotenusa y tan = opuesto/adyacente. Memoriza los valores de 30°, 45° y 60°, y recuerda que 180° = π radianes.",
    "ejemplo": {
      "enunciado": "Una rampa de 8 m de largo forma un ángulo de 30° con el suelo. ¿A qué altura llega?",
      "pasos": [
        "La rampa es la hipotenusa y la altura es el cateto opuesto al ángulo de 30°.",
        "Plantea: sen 30° = altura / 8.",
        "Despeja: altura = 8 · sen 30° = 8 · 1/2 = 4."
      ],
      "resultado": "La rampa llega a 4 m de altura."
    },
    "ojo": "Fíjate desde qué ángulo miras: el cateto opuesto a un ángulo agudo es el cateto adyacente del otro ángulo agudo."
  },
