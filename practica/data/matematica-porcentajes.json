  "repaso": {
    "idea": "El p% de una cantidad es cantidad × p/100 (por ejemplo, el 15% de 40 es 40 × 0,15). Para aumentar un p% se multiplica por (1 + p/100) y para descontar un p%, por (1 − p/100).",
    "ejemplo": {
      "enunciado": "Unos zapatos cuestan $40 y tienen un 15% de descuento. ¿Cuánto pagas?",
      "pasos": [
        "Calcula el descuento: 40 × 0,15 = 6.",
        "Réstalo del precio: 40 − 6 = 34.",
        "Atajo: pagas el 85% del precio, 40 × 0,85 = 34."
      ],
      "resultado": "Pagas $34."
    },
    "ojo": "Dos porcentajes seguidos no se suman ni se restan: subir un 20% y luego bajar un 20% deja el precio en el 96% del original, no en el 100%."
  },
