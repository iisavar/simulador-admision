    "ejemplo": {
      "enunciado": "Calcula: 47 × 19",
      "pasos": [
        "Piensa 19 como 20 − 1.",
        "47 × 20 = 940.",
        "47 × 1 = 47, y se resta: 940 − 47 = 893."
      ],
      "resultado": "893"
    },
    "ojo": "Al descomponer (20 + 3) × 4, multiplicar solo una parte: hay que multiplicar el 20 y también el 3."
