{
  "id": "matematica-productos",
  "materia": "matematica",
  "tema": "Productos notables",
  "bloque": "Álgebra",
  "nivel": "intermedio",
  "clase": null,
  "repaso": {
    "idea": "Los productos notables son multiplicaciones que se resuelven con una fórmula, sin multiplicar término a término: (a + b)² = a² + 2ab + b², (a − b)² = a² − 2ab + b² y (a + b)(a − b) = a² − b².",
    "ejemplo": {
      "enunciado": "Desarrolla (2x + 3)².",
      "pasos": [
        "Cuadrado del primero: (2x)² = 4x².",
        "Doble del primero por el segundo: 2·(2x)·3 = 12x.",
        "Cuadrado del segundo: 3² = 9.",
        "Junta los tres términos."
      ],
      "resultado": "4x² + 12x + 9"
    },
    "ojo": "(a + b)² NO es a² + b²: siempre falta el doble producto 2ab. Por ejemplo, (x + 3)² = x² + 6x + 9, no x² + 9."
  },
  "preguntas": [
